{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticPrefixChore",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":enableVulnerabilityAlerts",
    ":dependencyDashboard",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": true
  }
}
